 "policy_defs_readable": [
  [
   "Anyone can submit applications",
   "INSERT",
   "{anon,authenticated}",
   null,
   "(((char_length(full_name) >= 1) AND (char_length(full_name) <= 120)) AND ((char_length(email) >= 5) AND (char_length(email) <= 255)) AND (email ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'::text) AND ((char_length(phone) >= 7) AND (char_length(phone) <= 32)))"
  ],
  [
   "No direct application deletes",
   "DELETE",
   "{anon,authenticated}",
   "false",
   null
  ],
  [
   "Partners can view their assigned drivers",
   "SELECT",
   "{authenticated}",
   "((vehicle_id IS NOT NULL) AND private.partner_owns_vehicle(vehicle_id))",
   null
  ],
  [
   "Staff update applications",
   "UPDATE",
   "{authenticated}",
   "private.is_staff()",
   "private.is_staff()"
  ],
  [
   "Staff view applications",
   "SELECT",
   "{authenticated}",
   "private.is_staff()",
   null
  ],
  [
   "Users can view their own application",
   "SELECT",
   "{authenticated}",
   "((user_id IS NOT NULL) AND (user_id = auth.uid()))",
   null
  ],
  [
   "coordinator_application_containment",
   "SELECT",
   "{authenticated}",
   "((private.is_manager() IS TRUE) OR (private.is_staff() IS FALSE))",
   null
  ]
 ],
