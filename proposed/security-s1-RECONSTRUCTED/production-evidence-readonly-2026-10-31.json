 "triggers": [
  {
   "def": "CREATE TRIGGER applications_active_guard BEFORE INSERT OR UPDATE OF status ON public.applications FOR EACH ROW EXECUTE FUNCTION private.application_active_guard()",
   "enabled": "O",
   "function": "private.application_active_guard()",
   "function_def": "CREATE OR REPLACE FUNCTION private.application_active_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nBEGIN\n  IF NEW.status = 'active'\n     AND (TG_OP = 'INSERT' OR OLD.status IS DISTINCT FROM 'active')\n     AND NOT EXISTS (SELECT 1 FROM public.rentals r\n                     WHERE (r.application_id = NEW.id) AND r.status = 'active') THEN\n    RAISE EXCEPTION 'active_requires_running_rental'\n      USING HINT = 'A driver becomes Active only when a rental is started (activate_rental_tx).';\n  END IF;\n  RETURN NEW;\nEND $function$\n",
   "function_owner": "postgres",
   "function_proacl": null,
   "name": "applications_active_guard",
   "secdef": false,
   "tgtype": 23
  },
  {
   "def": "CREATE TRIGGER applications_updated_at BEFORE UPDATE ON public.applications FOR EACH ROW EXECUTE FUNCTION set_updated_at()",
   "enabled": "O",
   "function": "set_updated_at()",
   "function_def": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nBEGIN NEW.updated_at = now(); RETURN NEW; END $function$\n",
   "function_owner": "postgres",
   "function_proacl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
   "name": "applications_updated_at",
   "secdef": false,
   "tgtype": 19
  },
