{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "../.readiness-build",
    "rootDir": "../src/lib",
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmitOnError": true
  },
  "include": [
    "../src/lib/applicant-validation.ts",
    "../src/lib/assessment-guard.ts",
    "../src/lib/readiness-index.ts",
    "../src/lib/readiness.ts"
  ]
}
